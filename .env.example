# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/personal_dev_os
POSTGRES_DB=personal_dev_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Kakao OAuth (used from Milestone 3)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# GitHub activity integration (used from Milestone 7)
GITHUB_WEBHOOK_SECRET=
GITHUB_ACCESS_TOKEN=
GITHUB_ALLOWED_REPOSITORIES=
POST_SOURCE_EXTENSIONS=.py,.java,.cpp,.c,.js,.ts,.go,.kt

# LLM integration (used from Milestone 8)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Redis + Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False
